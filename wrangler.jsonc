{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Assets-only Worker: there is no server code, just the built bundle.
  // Response headers come from public/_headers, which Vite copies into dist/.
  "name": "zine-fold",
  "compatibility_date": "2026-08-08",

  // Two accounts are reachable from this login; pin the personal one.
  "account_id": "2b2bd51e849e796a537f76c3526709e4",

  // Serves the app at zine-fold.dusty-jewett.workers.dev. Turn this off once
  // zine-fold.com is live if you'd rather have a single canonical URL.
  "workers_dev": true,

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // Uncomment once zine-fold.com is registered and its zone is active in the
  // account above — a Custom Domain route fails to deploy until the zone
  // exists. The Worker is the origin, so Cloudflare then creates and manages
  // the DNS records and certificates itself. www is listed so typing it doesn't
  // dead-end; see the README for making the apex canonical.
  // "routes": [
  //   { "pattern": "zine-fold.com", "custom_domain": true },
  //   { "pattern": "www.zine-fold.com", "custom_domain": true }
  // ],

  "observability": {
    "enabled": true
  }
}
