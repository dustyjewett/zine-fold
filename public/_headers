# Response headers for Cloudflare Workers static assets.
# Vite copies this into dist/; Cloudflare parses it and does not serve it.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  # After load the app issues no network requests of any kind — it reads the
  # file with FileReader and builds the PDF in memory — so connect-src is
  # 'none' rather than 'self'. fetch/XHR/WebSocket/sendBeacon are all refused,
  # including back to this origin, which is what stops a compromised dependency
  # from quietly POSTing someone's document anywhere.
  #
  # Not covered by any of this: top-level navigation. CSP has no directive that
  # restricts `location = ...`, so this narrows the exfiltration surface a long
  # way but is not an absolute guarantee.
  #
  # blob: is needed on frame-src/object-src because the preview iframe renders
  # a blob: URL PDF. script-src 'self' is also what blocks Cloudflare's
  # auto-injected analytics beacon.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'none'; frame-src blob:; object-src blob:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# Vite fingerprints these filenames, so they can never go stale.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# no-store, not no-cache. This file's contents rarely change, so a revalidation
# returns 304 and the edge keeps serving its stored copy — including the stored
# *headers*. That made a CSP change silently fail to go live, and worse, it can
# pin users to a previous build, because index.html names hashed asset files.
# The document is ~2 KB gzipped and still served from the edge Worker, so not
# caching it costs nothing worth measuring.
#
# Both spellings: a request for "/" does not match the "/index.html" pattern.
/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store
